# Copy these into your host's secrets (Fly: fly secrets set NAME=value). Never commit real values.
APP_ENV=production
SECRET_KEY=                      # long random string, for example: python -c "import secrets;print(secrets.token_urlsafe(48))"
ALLOWED_HOSTS=banksview.com,www.banksview.com
BRAND_NAME=BanksView
DATA_DIR=/data
BACKUP_DAILY=1

# Sign-in codes by email (any SMTP provider: Zoho, Brevo, Amazon SES, Gmail app password)
OTP_PROVIDER=email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BanksView <no-reply@banksview.com>

# Payments: razorpay | upi_qr
PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_ID=
UPI_PAYEE_NAME=

# Pricing (paise). Packs are fixed in app/config.py.
PRICE_PAISE=5000
PRIVILEGED_PRICE_PAISE=2500
COUPONS_ENABLED=0

# Legal and contact details shown on the site
COMPANY_NAME=
COMPANY_ADDRESS=
GRIEVANCE_OFFICER=
GRIEVANCE_EMAIL=
KEEP_UPLOADED_PDF=0
REPORT_RETENTION_DAYS=90
