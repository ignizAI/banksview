# Copy these into your host's secrets (Fly: fly secrets set NAME=value). Never commit real values.
APP_ENV=production
SECRET_KEY=                      # long random string, for example: python -c "import secrets;print(secrets.token_urlsafe(48))"
ALLOWED_HOSTS=banksview.com,www.banksview.com
BRAND_NAME=BanksView
DATA_DIR=/data
BACKUP_DAILY=1


# Payments: razorpay | upi_qr
PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_ID=
UPI_PAYEE_NAME=

# Pricing (paise). Packs are fixed in app/config.py.
PRICE_PAISE=5000
PRIVILEGED_PRICE_PAISE=2500
COUPONS_ENABLED=0

# Legal and contact details shown on the site
COMPANY_NAME=
COMPANY_ADDRESS=
GRIEVANCE_OFFICER=
GRIEVANCE_EMAIL=
REPORT_RETENTION_DAYS=30
